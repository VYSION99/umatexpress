# Turso database
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=replace-with-turso-auth-token

# Payment provider: PAYSTACK while MTN MoMo KYC is pending, or MTN_MOMO later.
PAYMENT_PROVIDER=PAYSTACK

# Paystack Transactions API
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_SECRET_KEY=replace-with-paystack-secret-key
PAYSTACK_CURRENCY=GHS
PAYSTACK_FEE_PERCENT=1.95

# Cloudflare bindings. Every one is optional: leave a value to use the default,
# or set it empty to deploy without that binding. The bindings that name an
# account-side resource (R2, Queue) are created for you by
# scripts/deploy-cloudflare.sh. See docs/CLOUDFLARE_BINDINGS.md.
CLOUDFLARE_AI_BINDING=AI
CLOUDFLARE_IMAGES_BINDING=IMAGES
CLOUDFLARE_R2_BINDING=PRIVATE_BUCKET
CLOUDFLARE_R2_BUCKET=umatexpress-private
CLOUDFLARE_QUEUE_BINDING=NOTIFICATION_QUEUE
CLOUDFLARE_QUEUE=umatexpress-notifications
CLOUDFLARE_RATE_LIMITER_BINDING=RATE_LIMITER
# Subrequests one invocation may spend against Turso. One SQL statement is one
# subrequest. Leave this empty on the Workers free plan, which rejects the
# field; a paid plan can raise it to 1000 and every job then has more room.
CLOUDFLARE_SUBREQUEST_LIMIT=
# "BINDING=value" lists. Service bindings are off until a second Worker exists;
# mTLS is off until a certificate is uploaded (wrangler mtls-certificate upload).
CLOUDFLARE_SERVICE_BINDINGS=
CLOUDFLARE_MTLS_CERTIFICATES=

# Workers AI. The AI binding above is the preferred path and needs no token.
# These two are only the fallback for a deployment that cannot bind Workers AI.
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# The account the Worker deploys to. Its Zero Trust team is the only one that
# can protect the Worker's hostname, so use the UMaTeXPRESS-owned account.
CLOUDFLARE_ACCOUNT_ID=replace-with-cloudflare-account-id
CLOUDFLARE_AI_TOKEN=replace-with-workers-ai-token
# Binds the console custom domain on deploy. Leave empty to deploy without it,
# then the console only answers on the workers.dev host listed in CONSOLE_HOSTS.
CLOUDFLARE_CONSOLE_HOST=console.umatexpress.com
# Optional: deploy the console as its own Worker, which is what gives it a
# hostname (and an Access policy) of its own. Both keys are required together.
CLOUDFLARE_CONSOLE_WORKER_NAME=console-umatexpress
CLOUDFLARE_CONSOLE_HOSTS=console-umatexpress.<account-subdomain>.workers.dev

# Cinema voice and video. Study-room calls are a browser-to-browser mesh; the
# TURN relay below is only needed when two networks cannot connect directly.
# Create a TURN key in the Cloudflare dashboard (Realtime -> TURN server) and
# paste both values. Leave them empty and rooms fall back to Cloudflare's public
# STUN server: that works on campus networks, and the room says "Direct only".
CLOUDFLARE_TURN_KEY_ID=
# The key's API token. Server-side only: the Worker mints short-lived ICE
# credentials from it and never sends the token to a browser.
CLOUDFLARE_TURN_API_TOKEN=

# YouTube Data API v3 key, for the lobby's search bar: a student types what
# they want to watch and picks from a tray of results. The lookup runs on the
# server, so the key never reaches a browser, and each search is rate limited
# per student. Leave it empty and the lobby says search is not switched on and
# keeps the paste-a-link path, which needs no key at all.
YOUTUBE_API_KEY=

# Vector tile style for the MapLibre campus map. OpenFreeMap is keyless and
# free; swap in a self-hosted Protomaps style on R2 using the PRIVATE_BUCKET
# binding when you are ready to serve tiles yourself.
# Routes are drawn from corridor geometry, so no routing service is configured.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# MTN MoMo Collection API
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_TARGET_ENVIRONMENT=sandbox
MTN_MOMO_CURRENCY=EUR
MTN_MOMO_API_USER=replace-with-api-user
MTN_MOMO_API_KEY=replace-with-api-key
MTN_MOMO_COLLECTION_KEY=replace-with-collection-subscription-key

# Comma-separated accounts allowed to use /admin
ADMIN_EMAILS=admin@example.com

# Trust the oai-authenticated-user-email identity header. Leave false on a plain
# deployment: the header is client-controlled there and spoofable.
TRUST_PLATFORM_IDENTITY=false

# Local admin sign-in. Replace this before deploying: a value that still starts
# with "replace-with" falls back to the built-in default password, which is
# public knowledge. Change it after first login in any case.
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
DRIVER_SESSION_SECRET=replace-with-at-least-32-random-characters
# Signs the student account cookie. Falls back to DRIVER_SESSION_SECRET and then
# ADMIN_SESSION_SECRET, so a deployment that already sets either one keeps
# working; set it explicitly to keep student sessions on their own key.
STUDENT_SESSION_SECRET=replace-with-at-least-32-random-characters

# Seals the values the platform must read back, such as an organizer's payout
# account number and KYC ID number (AES-GCM, `v1:` prefix). Leave it blank and
# the platform falls back to ADMIN_SESSION_SECRET so an existing deployment
# keeps working. Rotating either key makes every previously sealed value
# unreadable, so set a dedicated key before real payouts run and store it
# somewhere you can find it again.
PAYOUT_ENCRYPTION_KEY=replace-with-at-least-32-random-characters

# Automated payouts. The cron releases what is due and sends it with Paystack
# Transfers, but only when this is explicitly true: a schedule that moves money
# should be something a deployment opts into. An administrator running the
# payout job from the console is attended and is not gated by it. Leave it
# false to keep the ledger and the statements without any transfer leaving.
#
# Console > Platform settings overrides this variable once an administrator
# saves a value there (an audited write), so this stays the deployment-wide
# fallback rather than the only way to change the policy.
PAYOUT_AUTO_ENABLED=false

# The same switch for hostel payouts, with the same console override. The
# hostel release job only runs when this is true; an administrator pressing
# "Send with Paystack" in the payout desk is attended and is not gated by it.
HOSTEL_PAYOUT_AUTO_ENABLED=false

# How long after a booking is paid its earnings become payable, in minutes.
# Paystack's mobile money transfers land in seconds, so this is the platform's
# own reversal window rather than the rail's: it is the only stretch in which a
# duplicated or mistaken payment can be undone by refusing the payout instead of
# clawing it back afterwards. 0 pays as soon as the settled balance allows.
# It is written onto each ledger entry as it is created, so changing it pays
# future bookings differently and never re-times money already earned.
# Overridable in the console's platform settings.
PAYOUT_RELEASE_MINUTES=20

# What Paystack charges per transfer, in pesewas. One number per rail, shared
# by every product that pays out of the same Paystack balance: a transfer costs
# the same whether it carries a trip's fares or a hostel's rent, so correcting
# a rate here (or in the console) corrects it everywhere. The rate follows the
# destination, so sending to mobile money and sending to a bank account are not
# the same price. The fee is deducted from the payout rather than charged to the
# platform, and an organizer's business profile quotes the mobile money rate
# before they save an account, so keep these honest: the number is the one the
# payee is shown and the one taken from them. Ride payouts use the MOMO rate
# only — organizers are paid to mobile money — while hostel landlords may use
# either. Both are overridable in the console's platform settings.
PAYOUT_TRANSFER_FEE_MOMO_PESEWAS=100
PAYOUT_TRANSFER_FEE_BANK_PESEWAS=800

# The smallest balance worth a transfer, in pesewas. A payout below this stays
# on the ledger and joins the next one, so a flat transfer fee cannot cost more
# than it delivers. It applies to trip organizers and hostel landlords alike,
# and the release job also refuses any payout that would not survive its own
# rail fee. Overridable in the console's platform settings.
PAYOUT_MIN_AMOUNT_PESEWAS=5000

# Signs the tokens and one-time codes used to reset a password or sign in
# without one, for both the console and student accounts. At least 32
# characters. Falls back to a session secret when unset, but a dedicated value
# is better: rotating it only invalidates recovery requests that are in flight.
AUTH_RECOVERY_SECRET=replace-with-at-least-32-random-characters

# Passenger mail and in-app notifications (driver accepted / arrived / trip
# completed). Resend is the only delivery channel. Every message is written to
# notification_outbox, where the student's in-app feed reads it, and the cron
# emails a copy. Leave the key blank to keep collecting in-app notifications
# without sending mail.
RESEND_API_KEY=replace-with-resend-api-key
# A verified Resend sender. The display name is optional.
RESEND_FROM=UMaTeXPRESS <rides@your-verified-domain>
# Optional reply-to address for passengers who answer the mail.
RESEND_REPLY_TO=

# Public origin used to build ticket links inside notification emails, e.g.
# https://umatexpress.acmdevelopers2020.workers.dev
CAMPUS_APP_URL=

# Official trip notice shown on the vacationRide booking page. These are only a
# fallback for a deployment where nothing has been saved yet; whatever an
# organiser saves in the console takes precedence. Leave them unset to hide the
# notice entirely instead of publishing placeholder times and contacts.
# The public card reads its route and drop-off points from the live approved
# trips, so these two values only show while nothing is on sale.
TRIP_NOTICE_TITLE=
TRIP_NOTICE_ROUTE=
TRIP_NOTICE_FARE=
TRIP_NOTICE_NIGHT_BUS=
# Comma-separated lists.
TRIP_NOTICE_DAY_BUSES=
TRIP_NOTICE_DROP_OFFS=
TRIP_NOTICE_AMENITIES=
TRIP_NOTICE_CONTACTS=

# Signs the console session cookie for every console service (admin, moderator,
# organizer, driver). At least 32 characters.
CONSOLE_SESSION_SECRET=
# The model the console assistant reasons with. It must support tool calling;
# the default is chosen for that, and CLOUDFLARE_AI_MODEL is the fallback.
CONSOLE_ASSISTANT_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# Hosts the console is served from, comma-separated, e.g.
# console.umatexpress.com,umatexpress.acmdevelopers2020.workers.dev
# List the workers.dev host too until the custom domain is live, otherwise the
# console has no reachable origin. Loopback is always allowed, so local
# development needs nothing here. Console routes always require a session
# regardless; this list is the additional host boundary.
CONSOLE_HOSTS=
