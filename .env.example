# Turso database
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=replace-with-turso-auth-token

# Payment provider: PAYSTACK while MTN MoMo KYC is pending, or MTN_MOMO later.
PAYMENT_PROVIDER=PAYSTACK

# Paystack Transactions API
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_SECRET_KEY=replace-with-paystack-secret-key
PAYSTACK_CURRENCY=GHS

# MTN MoMo Collection API
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_TARGET_ENVIRONMENT=sandbox
MTN_MOMO_CURRENCY=EUR
MTN_MOMO_API_USER=replace-with-api-user
MTN_MOMO_API_KEY=replace-with-api-key
MTN_MOMO_COLLECTION_KEY=replace-with-collection-subscription-key

# Comma-separated accounts allowed to use /admin
ADMIN_EMAILS=admin@example.com

# Local admin sign-in (change the default password after first login)
ADMIN_PASSWORD=Admin@12345
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
